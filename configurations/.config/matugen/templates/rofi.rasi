* {
  primary: {{colors.primary.default.hex}};
  border: {{colors.outline.default.hex}}80;
  bg: {{colors.surface.default.hex}}99; /* alpha suffix on window only now: FF=opaque, CC=~80%, 99=~60%, 80=~50% */
  highlight: {{colors.surface_variant.default.hex}}70;
  text-color: {{colors.on_surface.default.hex}};
  
  background-color: @bg;
  font: "JetBrains Mono Nerd Font 13";
}

element-text,
element-icon,
mode-switcher {
  background-color: inherit;
  text-color: inherit;
}

window {
  width: 648px;
  transparency: "real";
  background-color: @bg;
  border-color: @border;
  border: 1px;
  border-radius: 3px;
}

textbox-prompt-colon {
  text-color: @primary;
  str: "";
  expand: false;
  padding: 0px 15px 0px 0px;
  text-color: @text-color;
  background-color: transparent;
}

entry {
  placeholder: "";
  placeholder-color: @bg;
  background-color: transparent;
  text-color: @text-color;
  expand: true;
}
inputbar {
  background-color: @highlight;
  padding: 20 20;
  children: [textbox-prompt-colon,entry];
  expand: false;
  spacing: 5;
}

listview {
  background-color: transparent;
  columns: 1;
  lines: 7;
  padding: 20px 0px;
  margin: 0 12;
  spacing: 0;
  cycle: false;
  dynamic: true;
  layout: vertical;
  scrollbar: false;
}

mainbox {
  background-color: transparent;
  children: [inputbar,listview,mode-switcher];
}

element {
  orientation: horizontal;
  padding: 7px 10px;
  
  background-color: transparent;
}

element-text {
  margin: 0 0px;
  
  background-color: transparent;
  highlight: @primary;
  text-color: @text-color;
}

element-icon {
  margin: 0 10 0 0;
}

element selected {
  background-color: @highlight;
  text-color: @bg;
}

mode-switcher {
  background-color: transparent;
  spacing: 20;
  margin: 10 20 10 20;
  padding: 0 0 0 0;
}

button {
  margin: 0 0 10 0;
  padding: 10 0;
  
  text-color: @text-color;
  background-color: transparent;
}

button selected {
  padding: 8px;
  text-color: @text-color;
  background-color: @highlight;
}

